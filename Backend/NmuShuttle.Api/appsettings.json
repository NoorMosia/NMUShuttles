{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "PostgreSQL (Npgsql). In production this is supplied via the env var ConnectionStrings__DefaultConnection (e.g. the Supabase pooler string). Leave empty here so secrets are never committed.",
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharsLong!",
    "Issuer": "NmuShuttle.Api",
    "Audience": "NmuShuttle.Clients",
    "StudentTokenExpiryHours": 24,
    "MarshalTokenExpiryHours": 24,
    "AdminTokenExpiryHours": 8
  },
  "Firebase": {
    "ServiceAccountPath": "./firebase-service-account.json"
  },
  "Otp": {
    "ExpiryMinutes": 5
  },
  "ScanWindow": {
    "OpenAllTodayTrips": false
  },
  "Email": {
    "Resend": {
      "ApiKey": "",
      "FromAddress": "onboarding@resend.dev",
      "FromName": "NMU Shuttle"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
    "https://noormosia.github.io"
    ]
  }
}
